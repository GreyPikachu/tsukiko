<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Песочница выключена: нужен запуск /opt/homebrew/bin/whisper-cli,
	     afconvert и чтение аудио из любых папок. -->
	<!-- Диктовка: микрофон и перехват клавиш через CGEventTap. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
